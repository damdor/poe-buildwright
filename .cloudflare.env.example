# Copy this file to .cloudflare.env and fill in the values.
# .cloudflare.env is gitignored — never commit secrets.

# ---------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN
# Get it at: https://dash.cloudflare.com/profile/api-tokens
#   1. Click "Create Token" → "Custom token"
#   2. Permissions (add three rows):
#        Account · Cloudflare Pages         · Edit
#        Account · Access: Apps and Policies · Edit
#        Account · Account Settings          · Read
#   3. Account Resources: Include · <your account>
#   4. (Leave Zone Resources empty.)
#   5. Continue → Create Token → copy the value (shown once).
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID
# In the Cloudflare dashboard, any page after login shows it in the right
# sidebar under "Account ID". 32-char hex string.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# POE2_PROJECT_NAME
# Cloudflare Pages project name. Becomes <name>.pages.dev.
# Pick something obscure so the URL itself isn't trivially guessable.
# Must be lowercase letters / digits / hyphens, max 58 chars.
# ---------------------------------------------------------------------------
POE2_PROJECT_NAME=poe2-planner-mvp-CHANGE-ME

# ---------------------------------------------------------------------------
# POE2_ALLOWED_EMAILS
# Comma-separated list of emails that Cloudflare Access will let through.
# Anyone else hits the login page and can't get in.
# ---------------------------------------------------------------------------
POE2_ALLOWED_EMAILS=you@example.com
