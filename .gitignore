# External data we don't want to commit back
data/pob2/
data/raw/

# Generated by scripts/extract_sprite_assets.py (~144MB of per-sprite PNGs).
# Regenerable from data/pob2/ atlases; the manifest in data/parsed/tree_render/
# sprites.tsv is the source-of-truth listing.
viewer/assets/sprites/

# Generated by tree_render — the live HTML shell with the inline TREE
# data blob + the planner CSS. Reproduce with: ./target/release/tree_render
# --tree-dir data/parsed/CURRENT/tree --output viewer/planner.html
viewer/planner.html
viewer/assets/planner.css
viewer/tree-bake.svg
viewer/tree-baked.png
viewer/tree.svg
viewer/assets/tree-baked.png
viewer/assets/tree-base.png
# Misc one-off demo HTMLs from earlier prototyping iterations.
viewer/amazon_demo.html
viewer/full_tree.html

# Generated by scripts/extract_tree_data.py from data/pob2/.../tree.json.
# The .tsv files are large-ish and reproducible; keep the analyst .md
# reports in data/parsed/ (those are hand-curated, not generated).
# manifest.json is small + deterministic so it stays committed — used
# by scripts/build_manifests.py --check to detect drift.
# Pattern matches any patch directory under data/parsed/ (0_4, 0_5, ...).
data/parsed/*/tree/nodes.tsv
data/parsed/*/tree/edges.tsv
data/parsed/*/tree/meta.tsv
data/parsed/*/tree/sprites.tsv

# Skill data (Phase 1 of the build-planner roadmap). Same convention
# as tree/: TSVs are generated from PoB2 Lua sources, manifests ARE
# committed for drift detection.
data/parsed/*/skills/gems.tsv
data/parsed/*/skills/active_skills.tsv
data/parsed/*/skills/support_skills.tsv
data/parsed/*/skills/skill_levels.tsv

# Item data (Phase 3). Bases + uniques + per-variant unique stats.
data/parsed/*/items/bases.tsv
data/parsed/*/items/uniques.tsv
data/parsed/*/items/uniques_variants.tsv

# Icon mapping TSVs (Phase 2 + 3b). The actual .webp files live under
# viewer/assets/skill_icons/ and viewer/assets/item_icons/ — those are
# already covered by viewer/assets/sprites/ being ignored elsewhere,
# but explicitly listing the icon dirs makes intent clearer.
# icons.tsv (hotbar / skill-action), gem_icons.tsv (gem-as-item),
# items/icons.tsv (unique-item) — all generated by the scrapers.
# Note: gitignore does NOT support inline comments after a pattern.
data/parsed/*/skills/icons.tsv
data/parsed/*/skills/gem_icons.tsv
data/parsed/*/items/icons.tsv
viewer/assets/skill_icons/
viewer/assets/gem_icons/
viewer/assets/item_icons/

# Generated wizard catalogues — combine the per-patch TSVs into JSON
# the static pages can fetch (~600KB skills + ~190KB items). Regen
# via scripts/emit_wizard_catalogues.py.
viewer/assets/skill_catalogue.json
viewer/assets/item_catalogue.json

# Underscore-prefixed dirs under data/parsed/<patch>/ are scratch
# (intermediate Lua→JSON dumps used by the extractor, etc.) — never
# part of the committed data contract.
data/parsed/*/_*

# Build saves persisted by the serve crate at runtime.
builds/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Rust
target/
# Cargo.lock is intentionally committed at the workspace root for reproducible builds.

# Editor / OS
.vscode/
.idea/
.DS_Store

# Claude Code local settings (personal permission rules, not shared)
.claude/settings.local.json

# Cloudflare deploy credentials — never commit. Copy .cloudflare.env.example
# to .cloudflare.env and fill in the values. Used by scripts/deploy.sh.
.cloudflare.env
# Wrangler scratch dir (asset upload manifests, cache). Re-created on every
# `wrangler pages deploy`.
.wrangler/

# JS toolchain (vendored binaries reinstalled via tools/setup.sh).
# CHECKSUMS pins the versions; the actual binaries are too big / per-host.
tools/bin/
tools/typescript/

# esbuild's bundled outputs + source maps. Every .js under
# viewer/assets/ is generated from a .ts source by scripts/build_js.sh
# (every deploy rebuilds them). The .ts sources are the truth.
# scripts/verify_no_js_sources.sh catches stray hand-written .js.
viewer/assets/*.js
viewer/assets/*.js.map

# First-party miner dumps: `buildwright mine` writes raw GGG tables to
# data/parsed/<patch>_native/. Regenerable on demand and not yet shaped
# for the site, so we don't commit the bulk (~15 MB/patch); the `mine`
# capability + on-demand `manifest` are the tracked artefacts.
/data/parsed/*_native/
# Agent grounding data — generated from mined GGG game data (tree_render emits)
viewer/assets/agent/nodes.json
viewer/assets/agent/graph.json
viewer/assets/agent/bases.json
viewer/assets/agent/mods.json
viewer/assets/skill_stats.json

# Local-only: personal research, legacy scraped data, and the CURRENT
# patch symlink (environment state, set by `bw` patch switching).
data/poedb2/
data/patch_notes/
data/parsed/CURRENT
data/parsed/*.json

# ooz decoder sources — GPL/unlicensed upstream, NOT distributable by
# this repo. ooz_sys's build.rs fetches them (pinned commit, SHA-256
# verified) from zao/ooz; see crates/ooz_sys/VENDOR.md.
crates/ooz_sys/vendor/kraken.cpp
crates/ooz_sys/vendor/bitknit.cpp
crates/ooz_sys/vendor/lzna.cpp
crates/ooz_sys/vendor/stdafx.h

# Deploy provenance stamp — written by scripts/deploy.sh per deploy.
viewer/assets/deploy_meta.json
